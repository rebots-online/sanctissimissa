{
  "name": "st-androids-missal",
  "productName": "St. Android's Missal",
  "private": true,
  "version": "1.39.15371",
  "type": "module",
  "description": "Traditional Latin Mass and Divine Office as a navigable subway map \u2014 graph + vector liturgical corpus, exegetical reader, perpetual calendar. Tauri 2 multiplatform.",
  "scripts": {
    "predev": "node scripts/sync-db.mjs",
    "dev": "vite",
    "prestamp": "node scripts/sync-db.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "collect-artifacts": "node scripts/collect-artifacts.mjs",
    "package:android-symbols": "bash scripts/package-android-symbols.sh",
    "prebuild": "node scripts/sync-db.mjs",
    "pregate": "node scripts/pre-build-gate.mjs",
    "prebuild:vite": "node scripts/sync-db.mjs",
    "build:vite": "node scripts/pre-build-gate.mjs && tsc -b && vite build",
    "build": "npm run build:vite",
    "build:web": "npm run build:vite",
    "build:desktop": "node scripts/pre-build-gate.mjs && tauri build",
    "build:android": "node scripts/pre-build-gate.mjs && tauri android build --apk --aab",
    "build:windows:unstamped": "node scripts/pre-build-gate.mjs && bash scripts/build-windows.sh",
    "build:windows:msi": "powershell -NoProfile -NonInteractive -File scripts/standroidsmissal-v1.39.15371-windows-native-20260913.ps1 -Kind MSI",
    "build:windows:msix": "powershell -NoProfile -NonInteractive -File scripts/standroidsmissal-v1.39.15371-windows-native-20260913.ps1 -Kind MSIX",
    "build:release": "node scripts/release-state.mjs",
    "build:all": "node scripts/release-state.mjs",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests scripts vite.config.ts eslint.config.js",
    "ingest": "node --experimental-strip-types scripts/ingest-corpus.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@tauri-apps/api": "^2.4.0",
    "ckeditor5": "^48.5.0",
    "dompurify": "^3.4.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
