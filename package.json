{
  "name": "st-androids-missal",
  "productName": "St. Android's Missal",
  "private": true,
  "version": "1.37.82443",
  "type": "module",
  "description": "Traditional Latin Mass and Divine Office as a navigable subway map — graph + vector liturgical corpus, exegetical reader, perpetual calendar. Tauri 2 multiplatform.",
  "scripts": {
    "predev": "node scripts/sync-db.mjs",
    "dev": "vite",
    "prestamp": "node scripts/sync-db.mjs",
    "stamp": "node scripts/stamp-version.mjs",
    "collect-artifacts": "node scripts/collect-artifacts.mjs",
    "package:android-symbols": "bash scripts/package-android-symbols.sh",
    "prebuild": "node scripts/sync-db.mjs",
    "pregate": "node scripts/pre-build-gate.mjs",
    "build:vite": "node scripts/pre-build-gate.mjs && tsc -b && vite build",
    "build": "npm run build:vite",
    "build:web": "npm run stamp && npm run build:vite",
    "build:desktop": "npm run stamp && node scripts/pre-build-gate.mjs && tauri build",
    "build:android": "npm run stamp && node scripts/pre-build-gate.mjs && tauri android build --apk --aab",
    "build:windows:unstamped": "node scripts/pre-build-gate.mjs && bash scripts/build-windows.sh",
    "build:windows:msi": "node scripts/pre-build-gate.mjs && npm run build:vite && tauri build --target x86_64-pc-windows-msvc --bundles msi",
    "build:windows:msix": "node scripts/pre-build-gate.mjs && bash scripts/build-windows-msix.sh",
    "build:release": "bash scripts/build-release.sh",
    "build:all": "npm run build:release",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "ingest": "node --experimental-strip-types scripts/ingest-corpus.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@tauri-apps/api": "^2.4.0",
    "ckeditor5": "^48.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
