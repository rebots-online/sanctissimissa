node_modules/
# divinum-officium is too large (626MB) — clone separately if needed:
# https://github.com/DivinumOfficium/divinum-officium
VENDORED/divinum-officium
public/missal.db
# Root dist/ is the tracked, durable release artifact home (CC12/CC14).
# Web bundler output remains disposable and separate.
!/dist/
!/dist/**
dist-*/
# assets/missal.db is a symlink to the original repo (183MB, too large for GitHub free LFS).
# If missing, run `npm run ingest` to rebuild from VENDORED/.
assets/missal.db
src-tauri/target/
src-tauri/gen/android/app/build/
src-tauri/gen/android/tauri.properties
src-tauri/gen/apple/build/
*.local
.DS_Store
*.log
# Retained release evidence belongs in tracked root dist/ too (CC12).
!/dist/**/*.log
.env
.env.*
# The documented template is tracked — it carries keys, never values.
!.env.example
src-tauri/gen/schemas/
**/*.keystore
**/*.jks
**/*.p12
release.lock
build-logs/
sanctissimissa-release-state.json
tests/.tmp/
# MSIX build artifacts (winapp CLI)
devcert.pfx
msix-stage/

# tsc -b incremental state — build output; tracking it makes the
# pre-build gate fail on every build after the first.
tsconfig.tsbuildinfo

# Logs live in ~/Admin-Manual/LOGS/sanctissimissa/ (private synced repo).
LOGS/
.tmp/

# CI remains dormant; release builds are invoked manually.
.forgejo/

# Portable .lfsconfig is tracked and points all clones to authoritative Forgejo.
.lfsconfig.forgejo-backup

# Machine-local caches only (regenerated per workstation — never synced).
.remember/
.playwright-mcp/
.codegraph/

# Extracted AppImage runtime; retained locally, never source.
/squashfs-root/

# TEMPORARY operator exception (2026-09-18): Forgejo LFS outage.
# These existing release binaries exceed GitHub's 100 MiB ordinary-file limit.
# Keep local bytes and historical LFS objects; do not delete the artifacts.
# When Forgejo LFS returns: remove this block, git add these paths, then
# git lfs push --all origin master and push the restoration commit to both remotes.
# .gitattributes and .lfsconfig retain the Forgejo LFS configuration.
