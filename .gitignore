# pre-build gate fail on every build after the first.
tsconfig.tsbuildinfo

# Machine-local caches only (regenerated per workstation — never synced).
# Everything else, including credential-bearing history, is either committed
# or lives in the private synced Admin-Manual repo (Admin-Manual/LOGS/).
.remember/
.playwright-mcp/
