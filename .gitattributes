# Durable release binaries are stored on Forgejo LFS; GitHub gets pointers only.
# Keep release manifests, notes, and verification receipts readable in Git.
dist/**/*.apk filter=lfs diff=lfs merge=lfs -text
dist/**/*.aab filter=lfs diff=lfs merge=lfs -text
dist/**/*.exe filter=lfs diff=lfs merge=lfs -text
dist/**/*.msi filter=lfs diff=lfs merge=lfs -text
dist/**/*.msix filter=lfs diff=lfs merge=lfs -text
dist/**/*.AppImage filter=lfs diff=lfs merge=lfs -text
dist/**/*.deb filter=lfs diff=lfs merge=lfs -text
dist/**/*.zip filter=lfs diff=lfs merge=lfs -text
dist/**/*.db filter=lfs diff=lfs merge=lfs -text
VENDORED/models/sha256/** filter=lfs diff=lfs merge=lfs -text
# §L release inputs and the rpm artifact (DOCS/ARCHITECTURE/L-release-20261106.md §2.6; BA.9).
# .lfsconfig still names Forgejo: pushes use --no-verify, so objects stay in .git/lfs until OP.10.
dist/**/*.rpm filter=lfs diff=lfs merge=lfs -text
VENDORED/corpus/*.db filter=lfs diff=lfs merge=lfs -text
VENDORED/modules/*.db filter=lfs diff=lfs merge=lfs -text
