# St. Android's Missal — environment contract (copy to .env; .env is gitignored)
# Convention: DOCS/STORAGE-NAMESPACE.md ·
# ~/Admin-Manual/DOCS/TOOLING_CONVENTIONS/org-namespace-storage.md

# The app's org namespace (identifier family). Must match the packaged
# identifier in src-tauri/tauri.conf.json.
VITE_APP_NAMESPACE=mba.robin.sanctissimissa

# Storage scope for LARGE shared resources (LLM model weights, corpus and
# module caches):
#   common (default) — org-shared root `mba.robin`: one copy for all sibling
#                      apps instead of a download per app.
#   app              — app-private: `mba.robin.sanctissimissa`.
# Web (origin-scoped storage) and mobile (sandboxed app dirs) degrade to
# `app` by capability regardless of this toggle.
VITE_STORAGE_SCOPE=common

# Entitlements (RevenueCat public key). Absent ⇒ everything ungated.
# VITE_REVENUECAT_API_KEY=

# Secrets POINTER — Admin-Manual is the only secrets repository (cleartext,
# ASCII-armored + QR there); this repo never stores secret values. The build
# materializes the toolchain file from the canonical SHARED copy via
# scripts/provision-secrets.mjs (called by build_all.sh). All apps share the
# same Play upload keystore, hence one shared canonical properties file.
# SAM_KEYSTORE_PROPERTIES=~/Admin-Manual/CREDENTIALS/PlayStore/keystore.properties
